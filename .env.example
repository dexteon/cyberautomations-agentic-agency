# Core app
APP_ENV=development
APP_NAME=cyberautomations-agentic-agency
LOG_LEVEL=INFO
DEFAULT_TENANT=demo
HUMAN_REVIEW_REQUIRED=true

# LLM routing
PRIMARY_LLM_PROVIDER=anthropic
PRIMARY_LLM_MODEL=claude-3-7-sonnet-latest
FALLBACK_LLM_PROVIDER=glm
FALLBACK_LLM_MODEL=glm-4.5
SECONDARY_FALLBACK_PROVIDER=gemini
SECONDARY_FALLBACK_MODEL=gemini-2.5-pro
MODEL_ROUTING_STRATEGY=priority

# Keys
ANTHROPIC_API_KEY=
GLM_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
SERP_API_KEY=
APOLLO_API_KEY=
TELEGRAM_BOT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cyberautomations-agentic-agency/0.1

# Data / vector store
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=ca_
DATA_DIR=/app/data
OUTPUT_DIR=/app/output

# n8n / automation
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# GitHub / storage
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_OWNER=

# Website / intake / publishing
CYBERAUTOMATIONS_BASE_URL=https://cyberautomations.com
INTAKE_WEBHOOK_URL=
PUBLISH_BLOG=false
PUBLISH_REDDIT=false
PUBLISH_SOCIAL=false
BLOG_CMS_PROVIDER=
SOCIAL_PROVIDER=

# Structured logging
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID
